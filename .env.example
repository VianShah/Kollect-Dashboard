SESSION_SECRET=change-me
# API key for POST /api/ingest/events (dialer / WhatsApp platform webhooks)
INGEST_KEY=dev-key

# WhatsApp: Meta Cloud API. Values live in .env.local (local) and Render's environment (hosted).
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_ID=
WHATSAPP_WABA_ID=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_GRAPH_VERSION=v26.0
# test: borrower messages go to WHATSAPP_TEST_NUMBERS instead. live: borrowers' own numbers, real data only.
WHATSAPP_MODE=test
WHATSAPP_TEST_NUMBERS=
